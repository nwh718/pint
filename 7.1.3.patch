+    def get_unit_by_alias(self, alias: str) -> Optional[Unit]:
+        """
+        Reverse lookup a unit object by its alias (case-insensitive).
+        """
+        alias_lower = alias.lower()
+        for unit_name, unit_def in self._units.items():
+            if alias_lower == unit_name.lower():
+                return self.Unit(unit_name)
+            
+            aliases = getattr(unit_def, "_aliases", getattr(unit_def, "aliases", ()))
+            if any(alias_lower == a.lower() for a in aliases):
+                return self.Unit(unit_name)
+                
+        logger.warning(f"Unit alias '{alias}' not found.")
+        return None
